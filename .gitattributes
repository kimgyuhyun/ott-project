# Encrypted secrets must stay LF on every checkout (incl. self-hosted Windows
# runner). CRLF corrupts the SOPS metadata timestamp -> "parsing time ... \x0d".
*.enc text eol=lf

# 컨테이너 안에서 실행되는 셸 스크립트. CRLF 로 체크아웃되면 리눅스 bash 가
# '\r' 을 명령 일부로 읽어 깨진다. security/initdb/*.sh 는 postgres 컨테이너에
# 그대로 바인드 마운트되므로 러너 체크아웃의 줄바꿈이 곧 실행 결과가 된다.
*.sh text eol=lf

# 리눅스 컨테이너 안에서 파싱되는 프록시 설정. 러너 checkout 이 CRLF 로 내려주면
# dante sockd 가 첫 지시어에서 'near token "\r": syntax error' 로 죽고 재시작
# 루프에 빠진다(2026-08-08 실측 — SMTP 아웃바운드 전체 정지). squid 는 CRLF 를
# 견디지만 같은 마운트 경로라 둘을 갈라두지 않는다.
proxy/*.conf text eol=lf

# git 훅은 확장자가 없어 위의 *.sh 패턴에 걸리지 않는다. 지금은 윈도우에서만 실행돼
# 문제가 없지만, CRLF 로 체크아웃된 훅을 리눅스 sh 가 실행하면 셔뱅부터 깨지고
# 로컬에서 shellcheck 를 돌리면 SC1017 이 파일 전체에 뜬다(실측 24건, 전부 오탐).
.githooks/* text eol=lf

# java 소스. 이 줄이 없으면 Spotless 가 GIT_ATTRIBUTES 로 기대 줄바꿈을 정할 때 윈도우
# (core.autocrlf=true)는 CRLF 를, 리눅스 러너는 LF 를 기대한다. 양쪽이 각자 일관되면
# 문제가 없지만, 어떤 도구가 윈도우에서 LF 로 파일을 쓰는 순간 그 파일만 어긋나
# 로컬 spotlessCheck 만 깨진다(2026-08-23 실측: 로컬 9개 위반, 같은 커밋의 CI 는 전 잡 통과).
# 저장소 blob 은 이미 388개 전부 LF 라 이 줄은 blob 을 바꾸지 않는다 - 워킹트리만 맞춘다.
*.java text eol=lf
